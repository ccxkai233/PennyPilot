[Unit]
Description=PennyPilot PostgreSQL backup
Requires=docker.service pennypilot-compose.service
After=docker.service pennypilot-compose.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/root/PennyPilot
Environment=PENNYPILOT_BACKUP_DIR=/var/backups/pennypilot
Environment=PENNYPILOT_COMPOSE_ENV_FILE=/etc/pennypilot/compose.env
ExecStartPre=/usr/bin/install -d -m 0700 /var/backups/pennypilot
ExecStart=/root/PennyPilot/scripts/backup_postgres.sh
# Keep the service from hanging forever if Docker or PostgreSQL is unhealthy.
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
