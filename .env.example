# PostgreSQL (used by docker compose)
POSTGRES_DB=pennypilot
POSTGRES_USER=pennypilot
POSTGRES_PASSWORD=pennypilot_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Host bindings used by the production Compose stack.  They intentionally
# bind only to 127.0.0.1; Caddy is the public TLS entry point.
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Backend settings.  PENNYPILOT_* names are canonical; un-prefixed
# DATABASE_URL/SECRET_KEY/APP_ENV remain accepted for backwards compatibility.
PENNYPILOT_DATABASE_URL=postgresql+psycopg://pennypilot:pennypilot_dev_password@localhost:5432/pennypilot
PENNYPILOT_SECRET_KEY=replace-with-a-long-random-secret
PENNYPILOT_APP_ENV=development
PENNYPILOT_COOKIE_NAME=pennypilot_session
PENNYPILOT_COOKIE_SECURE=false
PENNYPILOT_COOKIE_SAMESITE=lax
# Either JSON (recommended) or a comma-separated list is accepted.
PENNYPILOT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PENNYPILOT_SESSION_TTL_DAYS=7

# Host and proxy allow-lists used by the production security middleware.
# The Compose service supplies production-safe defaults; keep these values in
# sync if you customize the public hostname or put another proxy in front.
PENNYPILOT_TRUSTED_HOSTS=localhost,127.0.0.1
# Individual addresses and CIDR networks are accepted.  In production,
# include only the verified Docker/Caddy proxy network (for example
# 172.20.0.0/16), never an arbitrary public range.
PENNYPILOT_TRUSTED_PROXY_IPS=127.0.0.1,::1
PENNYPILOT_LOGIN_RATE_LIMIT=5
PENNYPILOT_LOGIN_RATE_WINDOW_SECONDS=60
PENNYPILOT_LOGIN_BLOCK_SECONDS=300

# When the backend runs inside Docker Compose, it automatically builds a
# service-to-service URL using the POSTGRES_* values above.  Set this only if
# you use an external database or need a custom container-side URL.
# PENNYPILOT_CONTAINER_DATABASE_URL=postgresql+psycopg://user:password@db:5432/pennypilot

# Production overrides (required before exposing ledger.gitdo.net):
# PENNYPILOT_APP_ENV=production
# PENNYPILOT_SECRET_KEY=<generate with: openssl rand -hex 32>
# PENNYPILOT_COOKIE_SECURE=true
# PENNYPILOT_COOKIE_SAMESITE=lax
# PENNYPILOT_CORS_ORIGINS=https://ledger.gitdo.net
# PENNYPILOT_TRUSTED_HOSTS=ledger.gitdo.net,localhost,127.0.0.1
# PENNYPILOT_TRUSTED_PROXY_IPS=127.0.0.1,::1,172.20.0.0/16

# Optional AI integration
PENNYPILOT_AI_ENABLED=true
PENNYPILOT_AI_BASE_URL=https://api.openai.com
PENNYPILOT_AI_MODEL=gpt-4o-mini
# 接口格式：openai（/v1/chat/completions）、anthropic（/v1/messages）或 gemini（generateContent）
PENNYPILOT_AI_API_FORMAT=openai
# Optional installation-wide fallback key. Prefer the per-user encrypted
# setting in the web UI when multiple users or models are needed.
PENNYPILOT_AI_API_KEY=
PENNYPILOT_AI_FALLBACK_BASE_URL=https://api.openai.com
PENNYPILOT_AI_FALLBACK_MODEL=gpt-4o-mini
PENNYPILOT_AI_FALLBACK_API_FORMAT=openai
PENNYPILOT_AI_FALLBACK_API_KEY=
PENNYPILOT_AI_TIMEOUT_SECONDS=15
PENNYPILOT_AI_LOCAL_FALLBACK=true
# true：没有自己配置 AI 的用户使用上面的服务器接口地址、模型和 Key（单人自用/开发）。
# false：服务器的 AI 配置不对用户开放，每个用户需在设置页填写自己的接口。生产 Compose 默认 false。
PENNYPILOT_AI_SHARE_WITH_USERS=true
